# AWE System Environment Variables
# Copy this file to .env and fill in your values

# Database URL (SQLite for local development)
DATABASE_URL="file:./db/custom.db"

# Optional: API Keys can be set here or entered in the app
# GEMINI_API_KEY=your-gemini-api-key
# VISION_API_KEY=your-vision-api-key

# Optional: Override the primary cloud model (default: gemini-2.5-flash-lite)
# Free tier limits (per key): gemini-2.5-flash-lite = 15 req/min, 1000 req/day
#                             gemini-2.5-flash      = 10 req/min, 250 req/day
# The fallback chain (see src/lib/config.ts) is always active:
#   gemini-2.5-flash-lite → gemini-2.5-flash → gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash-lite
